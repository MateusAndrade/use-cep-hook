{
  "name": "use-cep-hook",
  "version": "2.0.0",
  "description": "A simple React Hook to fetch info of a CEP!",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MateusAndrade/use-cep-hook.git"
  },
  "author": "MateusAndrade",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/MateusAndrade/use-cep-hook/issues"
  },
  "homepage": "https://MateusAndrade.github.io/use-cep-hook",
  "keywords": [
    "cep",
    "postalcode",
    "hook",
    "react"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:hook": "tsc --project tsconfig-lib.json",
    "deploy-example": "gh-pages -d dist",
    "lint": "eslint ."
  },
  "dependencies": {
    "cep-promise": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/jest": "30.0.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.6",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.0.5",
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "gh-pages": "6.2.0",
    "globals": "15.14.0",
    "typescript-eslint": "8.20.0",
    "tslib": "^2.8.1",
    "husky": "9.1.7",
    "jsdom": "25.0.1",
    "lint-staged": "15.2.11",
    "prettier": "3.9.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "3.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint"
  },
  "hooks": {
    "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
    "pre-commit": "pnpm lint-staged"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
